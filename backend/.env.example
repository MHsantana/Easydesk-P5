# Copie este arquivo para ".env" e preencha com os seus valores.
# O arquivo .env NUNCA deve ir para o GitHub (ele já está no .gitignore).

# Porta do servidor
PORT=3333

# development | production | test
NODE_ENV=development

# Conexão com o PostgreSQL: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easydesk

# Banco separado usado só pelos testes automatizados (npm test). Ele é APAGADO a cada teste.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easydesk_test

# Use "true" em bancos na nuvem que exigem SSL (Neon, Supabase, Render...).
# No Neon: use a conexão direta (sem pooling) e apague da URL tudo a partir do "?".
DATABASE_SSL=false

# Segredo usado para assinar os tokens JWT. Use um texto longo e aleatório (mínimo 32 caracteres).
# Para gerar um: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-pelo-menos-32-caracteres

# Validade do token (ex.: 15m, 1h, 1d, 7d)
JWT_EXPIRES_IN=1d

# Endereços do frontend autorizados a chamar a API, separados por vírgula.
# Vazio = libera qualquer origem (prático no desenvolvimento, NÃO use assim em produção).
# Ex.: CORS_ORIGIN=http://127.0.0.1:5500,https://easydesk.vercel.app
CORS_ORIGIN=
